      "boundElements": [],
      "updated": 1788973737865,
      "link": null,
      "locked": false,
      "text": "Personal Reading Tracker:\nThe program should:\n\nStart with some books already entered.\nStore enough information about each book to identify it and track reading progress.\nLet the user view the books they're tracking.\nLet the user update the reading progress of one of those books.\nLet the user add another book later.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Personal Reading Tracker:\nThe program should:\n\nStart with some books already entered.\nStore enough information about each book to identify it and track reading progress.\nLet the user view the books they're tracking.\nLet the user update the reading progress of one of those books.\nLet the user add another book later.",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null,
      "created": null,
      "baseFontSize": null
    },
